"Zenith %@" = "Zenith %@";
"Check for Updates" = "Buscar actualizaciones";
"Check Automatically" = "Buscar automáticamente";
"Look for a new version once a day while Zenith is running." = "Busca una nueva versión una vez al día mientras Zenith está abierto.";
"What's New" = "Novedades";
"Install and Relaunch" = "Instalar y volver a abrir";
"Download…" = "Descargar…";
"Zenith %@ is available" = "Zenith %@ está disponible";
"Zenith %@ is available." = "Zenith %@ está disponible.";
"Open Settings › General to install it" = "Abre Ajustes › General para instalarla";
"Not checked yet." = "Aún no se ha comprobado.";
"Last checked %@." = "Última comprobación: %@.";
"Checking for updates…" = "Buscando actualizaciones…";
"Zenith is up to date." = "Zenith está actualizado.";
"Downloading Zenith %@…" = "Descargando Zenith %@…";
"Downloading Zenith %@… %@%%" = "Descargando Zenith %1$@… %2$@%%";
"Checking the signature of Zenith %@…" = "Comprobando la firma de Zenith %@…";
"Installing Zenith %@…" = "Instalando Zenith %@…";
"Zenith %@ is installed. Reopening…" = "Zenith %@ está instalado. Volviendo a abrir…";
"Zenith %@ is in your Downloads folder. Drag it to Applications to install it." = "Zenith %@ está en tu carpeta Descargas. Arrástralo a Aplicaciones para instalarlo.";
"Install Zenith %@?" = "¿Instalar Zenith %@?";
"Zenith downloads the update, checks that it is signed like this copy, replaces this copy and reopens. It quits for a moment while it does." = "Zenith descarga la actualización, comprueba que está firmada como esta copia, reemplaza esta copia y se vuelve a abrir. Se cierra un momento mientras lo hace.";
"Privacy Shield is on: quitting turns it off and ends the connections other apps have open through it. Turn it on again after Zenith reopens." = "Privacy Shield está activado: al salir se desactiva y se cierran las conexiones que otras apps tienen abiertas a través de él. Vuelve a activarlo cuando Zenith se abra de nuevo.";
"Zenith was updated. Quit and reopen it to start the new version." = "Zenith se ha actualizado. Sal y vuelve a abrirlo para usar la nueva versión.";
"Could not reach GitHub. Check your internet connection and try again." = "No se ha podido conectar con GitHub. Comprueba tu conexión a internet y vuelve a intentarlo.";
"GitHub is limiting requests from this network. Try again in an hour." = "GitHub está limitando las solicitudes desde esta red. Vuelve a intentarlo dentro de una hora.";
"GitHub answered with an error (HTTP %@). Try again later." = "GitHub ha respondido con un error (HTTP %@). Vuelve a intentarlo más tarde.";
"GitHub sent an answer Zenith could not read." = "GitHub ha enviado una respuesta que Zenith no ha podido leer.";
"The latest release on GitHub does not have a version number Zenith understands." = "La última versión publicada en GitHub no tiene un número de versión que Zenith entienda.";
"The latest release on GitHub has no Zenith download Zenith can trust." = "La última versión publicada en GitHub no tiene ninguna descarga de Zenith en la que Zenith pueda confiar.";
"This copy of Zenith is not signed with a stable identity, so an update cannot be verified." = "Esta copia de Zenith no está firmada con una identidad estable, así que no se puede verificar una actualización.";
"Zenith could not read its own signature, so an update cannot be verified." = "Zenith no ha podido leer su propia firma, así que no se puede verificar una actualización.";
"Zenith is not running from an app bundle, so it cannot replace itself." = "Zenith no se está ejecutando desde un paquete de app, así que no puede reemplazarse a sí mismo.";
"macOS is running Zenith from a temporary copy. Move Zenith to the Applications folder, open it from there and try again." = "macOS está ejecutando Zenith desde una copia temporal. Mueve Zenith a la carpeta Aplicaciones, ábrelo desde allí y vuelve a intentarlo.";
"Zenith is running from a disk image or an external drive, so it cannot replace itself." = "Zenith se está ejecutando desde una imagen de disco o un disco externo, así que no puede reemplazarse a sí mismo.";
"Zenith cannot write to the folder it is installed in." = "Zenith no puede escribir en la carpeta en la que está instalado.";
"The downloaded app has no readable Info.plist. Nothing was changed." = "La app descargada no tiene un Info.plist legible. No se ha cambiado nada.";
"The downloaded app is not Zenith. Nothing was changed." = "La app descargada no es Zenith. No se ha cambiado nada.";
"The download was announced as Zenith %@ but contains version %@. Nothing was changed." = "La descarga se anunciaba como Zenith %1$@, pero contiene la versión %2$@. No se ha cambiado nada.";
"The downloaded Zenith %@ is not newer than this copy (%@). Nothing was changed." = "El Zenith %1$@ descargado no es más reciente que esta copia (%2$@). No se ha cambiado nada.";
"The downloaded app is not signed by the same signer as this copy of Zenith (%@). Nothing was changed." = "La app descargada no está firmada por el mismo firmante que esta copia de Zenith (%@). No se ha cambiado nada.";
"The release does not point at a Zenith download Zenith can trust. Nothing was changed." = "La versión publicada no apunta a una descarga de Zenith en la que Zenith pueda confiar. No se ha cambiado nada.";
"The download failed (%@). Nothing was changed." = "La descarga ha fallado (%@). No se ha cambiado nada.";
"The download is far larger than a Zenith release, so it was stopped. Nothing was changed." = "La descarga es mucho mayor que una versión de Zenith, así que se ha detenido. No se ha cambiado nada.";
"The download is not the size GitHub announced. Nothing was changed." = "La descarga no tiene el tamaño que anunció GitHub. No se ha cambiado nada.";
"The download does not match the checksum GitHub published. Nothing was changed." = "La descarga no coincide con la suma de comprobación que publicó GitHub. No se ha cambiado nada.";
"The downloaded disk image could not be opened. Nothing was changed." = "No se ha podido abrir la imagen de disco descargada. No se ha cambiado nada.";
"The downloaded disk image does not contain Zenith.app. Nothing was changed." = "La imagen de disco descargada no contiene Zenith.app. No se ha cambiado nada.";
"The new version could not be copied (%@). Nothing was changed." = "No se ha podido copiar la nueva versión (%@). No se ha cambiado nada.";
"The new version could not be put in place (%@). This copy of Zenith was kept." = "No se ha podido colocar la nueva versión (%@). Se ha conservado esta copia de Zenith.";

